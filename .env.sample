# Full URL of a Chat Completions-compatible endpoint.
LLM_BASE_URL=https://your-llm-gateway.example/v1/chat/completions
LLM_API_KEY=

# Authentication is configurable because gateways use different headers.
# Use <none> as the header to omit authentication or as the prefix for a raw key.
LLM_AUTH_HEADER=Authorization
LLM_AUTH_PREFIX=Bearer

# Use one model for all roles, or override PLAN and AGENT separately.
LLM_MODEL=your-model-id
# LLM_MODEL_PLAN=your-planning-model-id
# LLM_MODEL_AGENT=your-execution-model-id

# Dot-separated path from the response root to the choices array.
LLM_CHOICES_PATH=choices

# Optional gateway/model-specific request fields. Must be a JSON object.
LLM_EXTRA_BODY_JSON={}
LLM_STRUCTURED_OUTPUT=json_schema
LLM_VERIFY_TLS=true
LLM_MAX_COMPLETION_TOKENS=24000
LLM_MAX_TOKENS_FIELD=max_tokens
LLM_REQUEST_TIMEOUT_SECONDS=300
LLM_REQUEST_ATTEMPTS=3
LLM_SCHEMA_ATTEMPTS=3
